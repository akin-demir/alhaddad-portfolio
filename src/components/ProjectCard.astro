---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import { getProjectCopy, normalizeLocale } from '../lib/i18n.js';

interface Props {
  project: CollectionEntry<'projects'>;
  delay?: number;
  locale?: string;
}

const { project, delay = 0 } = Astro.props;
const locale = normalizeLocale(Astro.props.locale);
const localized = getProjectCopy(locale, project.id, project.data);
const { title, summary } = localized;
const { year, tags, cover, coverAlt } = project.data;
const href = url(`/${locale}/projects/${project.id}/`);
---

<li class="card" data-reveal style={`--delay: ${delay}ms`}>
  {cover && (
    <span class="card-media">
      <Image
        src={cover}
        alt={coverAlt || `${title} preview`}
        widths={[320, 640]}
        sizes="(max-width: 640px) 100vw, 20rem"
        loading="lazy"
      />
    </span>
  )}
  <h3><a href={href}>{title}</a></h3>
  <p class="summary">{summary}</p>
  <div class="card-meta">
    <span>{year}</span>
    {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
  </div>
</li>
