---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import SceneLayer from '../components/SceneLayer.astro';
import { url } from '../lib/url';
import site from '../../content/site.json';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image for social cards. Defaults to /og.png */
  image?: string;
  /** Extra JSON-LD to emit alongside the site-wide Person schema. */
  schema?: Record<string, unknown>;
}

const { title, description = site.tagline, image, schema } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);

// Person schema powers entity recognition in search — it tells Google this is
// a specific human with these profiles, rather than an unattributed page.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  description: site.tagline,
  address: { '@type': 'PostalAddress', addressCountry: site.location },
  sameAs: site.links.filter((l) => l.url.startsWith('http')).map((l) => l.url),
  worksFor: site.experience.slice(0, 1).map((job) => ({
    '@type': 'Organization',
    name: job.org,
  }))[0],
  alumniOf: site.education.map((ed) => ({
    '@type': 'EducationalOrganization',
    name: ed.org,
  })),
  knowsAbout: site.skills.flatMap((group) => group.items),
  knowsLanguage: site.languages.map((l) => l.name),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d0d11" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    {/* Plain-text summary of the site for LLM assistants — see
        src/pages/llms.txt.ts and https://llmstxt.org */}
    <link rel="alternate" type="text/plain" href={url('/llms.txt')} title="llms.txt" />

    <ClientRouter />

    {/* Set theme and mark JS available before first paint — no flash, and the
        reveal animations only arm when JS can actually un-hide them. */}
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const saved = localStorage.getItem('theme');
          if (saved) document.documentElement.dataset.theme = saved;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>

    <SceneLayer />

    <div class="aurora" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a href={url('/')} class="wordmark">
          {site.firstName ?? site.name.split(' ')[0]}<span class="dot">.</span>
        </a>
        <nav>
          <a href={url('/')}>Home</a>
          <a href={url('/projects/')}>Projects</a>
          {site.resume && <a href={url(site.resume)}>CV</a>}
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {site.name}</p>
      <ul class="footer-links">
        {site.links.map((link) => (
          <li><a href={link.url}>{link.label}</a></li>
        ))}
      </ul>
    </footer>

    <script>
      // Scroll-reveal + progress bar. Re-run after every view transition,
      // since astro:page-load fires on initial load and on each navigation.
      const init = () => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
          );
          targets.forEach((el) => io.observe(el));
        }

        const bar = document.querySelector<HTMLElement>('.scroll-progress');
        const header = document.querySelector<HTMLElement>('.site-header');
        const onScroll = () => {
          const max = document.body.scrollHeight - innerHeight;
          if (bar) bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
          header?.classList.toggle('is-stuck', scrollY > 12);
        };
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });
      };

      document.addEventListener('astro:page-load', init);

      // Failsafe: reveal styles hide content until JS un-hides it, so if
      // astro:page-load never fires the page would read as blank. Force
      // everything visible shortly after load if nothing has revealed yet.
      addEventListener('load', () => {
        setTimeout(() => {
          if (!document.querySelector('[data-reveal].is-visible')) {
            document
              .querySelectorAll('[data-reveal]')
              .forEach((el) => el.classList.add('is-visible'));
          }
        }, 1200);
      });
    </script>
  </body>
</html>
