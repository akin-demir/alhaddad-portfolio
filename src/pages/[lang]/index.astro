---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import portrait from '../../assets/portrait.png';
import { getSiteCopy, supportedLocales, ui } from '../../lib/i18n.js';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return supportedLocales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props;
const site = getSiteCopy(locale);
const t = ui[locale];
const all = await getCollection('projects');
const featured = all
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const shown = featured.length > 0 ? featured : all.slice(0, 3);
const currentPath = `/${locale}/`;
---

<Base locale={locale} currentPath={currentPath}>
  <section class="hero" data-scene="graph">
    <div class="hero-text">
      {site.available && (
        <p class="eyebrow" data-reveal>
          <span class="pulse"></span>{site.availableLabel}
        </p>
      )}
      <h1 data-reveal style="--delay: 80ms">
        {site.headline.lead} <em>{site.headline.emphasis}</em>.
      </h1>
      <p class="role" data-reveal style="--delay: 160ms">
        {site.role} &middot; {site.location}
      </p>
      <p class="tagline" data-reveal style="--delay: 220ms">{site.tagline}</p>
      <div class="hero-links" data-reveal style="--delay: 300ms">
        {site.links.map((link) => (
          <a href={link.url} class={link.primary ? 'pill pill-primary' : 'pill'}>
            {link.label}
          </a>
        ))}
        <a href={url(site.resume)} class="pill">{t.downloadCv}</a>
      </div>
    </div>

    <div class="portrait-wrap" data-reveal style="--delay: 120ms">
      <Image
        src={portrait}
        alt={`Portrait of ${site.name}`}
        widths={[280, 560]}
        sizes="(max-width: 40rem) 60vw, 17rem"
        class="portrait"
        loading="eager"
      />
    </div>
  </section>

  <section class="stats" data-reveal>
    {site.stats.map((stat) => (
      <div class="stat">
        <span class="stat-value">{stat.value}</span>
        <span class="stat-label">{stat.label}</span>
      </div>
    ))}
  </section>

  <section>
    <div class="section-head" data-reveal>
      <h2>{t.selectedWork}</h2>
      <a href={url(`/${locale}/projects/`)}>{t.allProjects} &rarr;</a>
    </div>
    <ul class="project-grid">
      {shown.map((project, index) => (
        <ProjectCard project={project} locale={locale} delay={index * 90} />
      ))}
    </ul>
  </section>

  <section data-scene="stack">
    <div class="section-head" data-reveal><h2>{t.about}</h2></div>
    {site.about.map((paragraph, index) => (
      <p data-reveal style={`--delay: ${index * 80}ms`}>{paragraph}</p>
    ))}
  </section>

  <section data-scene="vision">
    <div class="section-head" data-reveal><h2>{t.experience}</h2></div>
    <ol class="timeline">
      {site.experience.map((job, index) => (
        <li data-reveal style={`--delay: ${index * 100}ms`}>
          <div class="timeline-head">
            <h3>{job.role}</h3>
            <span class="dates">{job.start} &ndash; {job.end}</span>
          </div>
          <p class="org">{job.org} &middot; {job.location}</p>
          <ul class="bullets">
            {job.points.map((point) => <li>{point}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section data-scene="semantic">
    <div class="section-head" data-reveal><h2>{t.toolkit}</h2></div>
    <ul class="skills">
      {site.skills.map((group, index) => (
        <li data-reveal style={`--delay: ${index * 70}ms`}>
          <h3>{group.group}</h3>
          <ul>
            {group.items.map((item) => <li class="tag">{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section data-scene="documents">
    <div class="section-head" data-reveal><h2>{t.publications}</h2></div>
    <ol class="pubs">
      {site.publications.map((publication, index) => (
        <li data-reveal style={`--delay: ${index * 80}ms`}>
          <span class="pub-title">
            {publication.url ? <a href={publication.url}>{publication.title}</a> : publication.title}
          </span>
          <span class="pub-venue">{publication.venue} &middot; {publication.year}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="closing" data-scene="converge">
    <div>
      <div class="section-head" data-reveal><h2>{t.education}</h2></div>
      {site.education.map((education) => (
        <p data-reveal>
          <strong>{education.degree}</strong><br />
          <span class="org">{education.org} &middot; {education.years}</span>
        </p>
      ))}
    </div>
    <div>
      <div class="section-head" data-reveal><h2>{t.languages}</h2></div>
      <ul class="langs" data-reveal>
        {site.languages.map((language) => (
          <li><span>{language.name}</span> <span class="dates">{language.level}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
