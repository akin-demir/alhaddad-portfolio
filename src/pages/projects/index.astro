---
import { url } from '../../lib/url';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Projects — Elhaddad</title>
    <script is:inline define:vars={{ base }}>
      (() => {
        const supported = ['en', 'de', 'ar', 'tr'];
        let preferred = '';
        try { preferred = localStorage.getItem('locale') || ''; } catch {}
        const detected = (navigator.languages || [navigator.language])
          .map((item) => String(item || '').toLowerCase().split('-')[0])
          .find((item) => supported.includes(item));
        const locale = supported.includes(preferred) ? preferred : (detected || 'en');
        location.replace(`${base.replace(/\/$/, '')}/${locale}/projects/`);
      })();
    </script>
  </head>
  <body><noscript><a href={url('/en/projects/')}>Continue in English</a></noscript></body>
</html>
