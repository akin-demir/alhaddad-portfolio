---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
// `url` is the imported base-path helper, so the frontmatter field is
// renamed to avoid shadowing it.
const {
  title, summary, year, tags, url: liveUrl, repo, cover, coverAlt,
  deployment, partners, program, status, role,
} = project.data;

const facts = [
  status && { label: 'Status', value: status },
  role && { label: 'Role', value: role },
  partners.length && { label: 'Partners', value: partners.join(' · ') },
  program && { label: 'Programme', value: program },
].filter(Boolean) as { label: string; value: string }[];
---

<Base title={title} description={summary}>
  <a href={url("/projects/")} class="back-link">&larr; All projects</a>

  <header class="detail-header">
    <h1>{title}</h1>
    <p>{summary}</p>
    <div class="card-meta">
      <span>{year}</span>
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    {(liveUrl || repo) && (
      <div class="detail-links">
        {liveUrl && <a href={liveUrl} class="pill">Live site &rarr;</a>}
        {repo && <a href={repo} class="pill">Source &rarr;</a>}
      </div>
    )}
  </header>

  {(facts.length > 0 || deployment.length > 0) && (
    <section class="facts">
      {facts.map((fact) => (
        <div class="fact">
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
      {deployment.length > 0 && (
        <div class="fact fact-wide">
          <dt>Deployed</dt>
          <dd>
            <ul class="deploy-list">
              {deployment.map((site) => <li>{site}</li>)}
            </ul>
          </dd>
        </div>
      )}
    </section>
  )}

  {cover && (
    <figure class="detail-media">
      <Image
        src={cover}
        alt={coverAlt || `${title} screenshot`}
        widths={[640, 900, 1280]}
        sizes="(max-width: 56rem) 100vw, 52rem"
        loading="eager"
      />
    </figure>
  )}

  <div class="prose">
    <Content />
  </div>
</Base>
