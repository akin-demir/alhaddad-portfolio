---
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { slug: project.id } }));
}

const { slug } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Project — Elhaddad</title>
    <script is:inline define:vars={{ base, slug }}>
      (() => {
        const supported = ['en', 'de', 'ar', 'tr'];
        let preferred = '';
        try { preferred = localStorage.getItem('locale') || ''; } catch {}
        const detected = (navigator.languages || [navigator.language])
          .map((item) => String(item || '').toLowerCase().split('-')[0])
          .find((item) => supported.includes(item));
        const locale = supported.includes(preferred) ? preferred : (detected || 'en');
        location.replace(`${base.replace(/\/$/, '')}/${locale}/projects/${slug}/`);
      })();
    </script>
  </head>
  <body>
    <noscript><a href={url(`/en/projects/${slug}/`)}>Continue in English</a></noscript>
  </body>
</html>
