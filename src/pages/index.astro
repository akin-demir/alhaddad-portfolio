---
import { url } from '../lib/url';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Elhaddad</title>
    <script is:inline define:vars={{ base }}>
      (() => {
        const supported = ['en', 'de', 'ar', 'tr'];
        let preferred = '';
        try { preferred = localStorage.getItem('locale') || ''; } catch {}
        const browserLocales = navigator.languages?.length ? navigator.languages : [navigator.language];
        const detected = browserLocales
          .map((item) => String(item || '').toLowerCase().split('-')[0])
          .find((item) => supported.includes(item));
        const locale = supported.includes(preferred) ? preferred : (detected || 'en');
        const root = base.replace(/\/$/, '');
        location.replace(`${root}/${locale}/`);
      })();
    </script>
  </head>
  <body>
    <noscript><a href={url('/en/')}>Continue in English</a></noscript>
  </body>
</html>
